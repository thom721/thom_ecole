# Secrets pour docker-compose.web.yml (déploiement web, serveur partagé).
# Copie ce fichier en .env.web (jamais commité, voir .gitignore) et remplace
# les valeurs par les vraies avant de lancer :
#   docker compose -f docker-compose.web.yml --env-file .env.web up -d --build

MYSQL_ROOT_PASSWORD=changeme
SECRET_KEY=change-moi-en-production

# Optionnel — adresse MAC de la machine hôte pour la licence (voir
# scripts/start.sh, app/Helper/license_check.py). Laisse vide pour la
# calculer automatiquement depuis l'intérieur du conteneur.
HOST_MAC_ADDRESS=
