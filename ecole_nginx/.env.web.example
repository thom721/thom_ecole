# Secrets pour docker-compose.web.yml (déploiement web, serveur partagé).
# Copie ce fichier en .env.web (jamais commité, voir .gitignore) et remplace
# les valeurs par les vraies avant de lancer :
#   docker compose -f docker-compose.web.yml --env-file .env.web up -d --build

MYSQL_ROOT_PASSWORD=changeme
SECRET_KEY=change-moi-en-production

# Optionnel — adresse MAC de la machine hôte pour la licence (voir
# scripts/start.sh, app/Helper/license_check.py). Laisse vide pour la
# calculer automatiquement depuis l'intérieur du conteneur.
HOST_MAC_ADDRESS=

# Optionnel — origine(s) autorisées en CORS (voir app/main.py). Laisse vide
# pour autoriser "*" (pratique en dev, à éviter en prod). En production,
# restreins au domaine réel du frontend — plusieurs origines séparées par
# des virgules si besoin (ex: https://iusth.edu.ht,https://www.iusth.edu.ht).
BACKEND_CORS_ORIGINS=https://iusth.edu.ht

# SMTP (voir app/utils/students_email.py) — deux boîtes distinctes :
# noreply@ pour les notifications automatiques (activation de compte),
# contact@ pour le formulaire de contact public (envoie et reçoit sur la
# même boîte, Reply-To sur l'expéditeur).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
MAIL_FROM_NAME=IUSTH
SMTP_USER_NOREPLY=noreply@iusth.edu.ht
SMTP_PASSWORD_NOREPLY=changeme
SMTP_USER_CONTACT=contact@iusth.edu.ht
SMTP_PASSWORD_CONTACT=changeme

# URL publique du frontend (lien "Se connecter" dans les emails d'activation,
# voir app/utils/students_email.py) — pas l'adresse LAN locale.
FRONTEND_URL=https://iusth.edu.ht

# Webhook de synchronisation temps réel VERS elearning-iusth (Épic 20) —
# URL de production d'elearning-iusth + même clé que son .env.production::
# ECOLE_NGINX_WEBHOOK_KEY. Laisse vide pour désactiver (aucun appel tenté).
ELEARNING_WEBHOOK_URL=https://elearning.infini-software.cloud/api/v1
ELEARNING_WEBHOOK_KEY=changeme

# Export en lecture seule pour elearning-iusth (import de cours + synchro
# identifiants professeur/personnel, Épic 22) — même valeur que
# elearning-iusth/.env.production::ECOLE_NGINX_INTEGRATION_KEY.
INTEGRATION_API_KEY=changeme
# false par défaut — active seulement si la synchro des identifiants
# (mot de passe copié) est réellement voulue en production.
INTEGRATION_ALLOW_CREDENTIAL_SYNC=false
