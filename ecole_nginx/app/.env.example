# Modèle de configuration de l'API — copier en app/.env (jamais commité,
# ignoré par .gitignore) et remplir les valeurs. Chaque serveur garde son
# propre app/.env : ne pas en garder en local, sinon il part avec le
# déploiement (COPY app ./app dans le Dockerfile, copie du dossier app/)
# et écrase celui du cloud.
#
# Les variables définies dans docker-compose*.yml (bloc "environment:")
# restent prioritaires sur ce fichier (load_dotenv n'écrase pas une
# variable déjà présente dans l'environnement).

APPNAME=https://aplekol360.local
URL=https://aplekol360.local

BASE_URL1=https://aplekol360.local
STORAGE_PATH=/static/

# Environnement
ENVIRONMENT=development

# Base de données
DATABASE_URL=mysql+pymysql://username:password@localhost/school_database

# Sécurité
SECRET_KEY=votre-cle-secrete-tres-longue-et-complexe-ici

# CORS (séparés par des virgules)
BACKEND_CORS_ORIGINS=http://localhost:5173,https://aplekol360.local

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
MAIL_FROM_NAME='IUSTH'

# Notifications automatiques (activation de compte professeur/personnel/étudiant)
SMTP_USER_NOREPLY=noreply@example.com
SMTP_PASSWORD_NOREPLY=

# Formulaire de contact public (envoie et reçoit sur la même boîte)
SMTP_USER_CONTACT=contact@example.com
SMTP_PASSWORD_CONTACT=

# URL publique du frontend (lien "Se connecter" dans les emails d'activation)
FRONTEND_URL=https://iusth.edu.ht

# DISABLE_LICENSE_CHECK ne se définit pas ici : uniquement dans le bloc
# "environment:" de docker-compose.web.yml (déploiement web), ou à la main
# en local (DISABLE_LICENSE_CHECK=true docker compose up -d --build app).

# Redis (optionnel)
REDIS_URL=redis://localhost:6379/0
