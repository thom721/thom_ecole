# Modèle sans valeurs réelles — copier en ".env" à la racine et remplir
# avec de vraies valeurs (jamais committer le ".env" réel, voir .gitignore).
# Consommé par docker-compose.yml ET docker-compose.jitsi.yml.

# --- Base de données ---
MYSQL_ROOT_PASSWORD=change-moi
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-moi
DB_NAME=elearning_iusth

# --- Application ---
SECRET_KEY=change-moi-genere-aleatoirement
BACKEND_CORS_ORIGINS_RAW=http://localhost:5173,http://localhost:5174
UPLOAD_DIR=/data/uploads
FRONTEND_BASE_URL=http://localhost:5173

# Premier compte admin (voir Helper/bootstrap_admin.py) — laisse vide pour
# ne rien faire. Rempli, crée ce compte au tout premier démarrage
# seulement (jamais si un admin existe déjà), avec toutes les permissions.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Intégration ecole_nginx (même valeurs que ecole_nginx/.env) ---
ECOLE_NGINX_BASE_URL=http://host.docker.internal:9001/api/v1
ECOLE_NGINX_INTEGRATION_KEY=
ECOLE_NGINX_AUTO_PROVISION_TEACHERS=false
ECOLE_NGINX_WEBHOOK_KEY=

# --- Email ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=

# --- Jitsi Meet (backend app + stack docker-compose.jitsi.yml) ---
# 0 en dev local (le conteneur gère son propre certificat auto-signé),
# 1 en production (TLS terminé par un nginx hôte devant lui).
JITSI_DISABLE_HTTPS=0
JITSI_BASE_URL=https://localhost:8443
JITSI_JWT_APP_ID=elearning_iusth
JITSI_JWT_APP_SECRET=
JWT_APP_ID=elearning_iusth
JWT_APP_SECRET=
JICOFO_AUTH_PASSWORD=
JICOFO_COMPONENT_SECRET=
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=
TZ=America/Port-au-Prince
